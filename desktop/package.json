{
  "name": "studioai-desktop",
  "productName": "StudioAI",
  "version": "0.1.0",
  "private": true,
  "description": "Local AI creation and social media studio",
  "author": "orest3781",
  "main": "main.cjs",
  "repository": "https://github.com/orest3781/studioAI",
  "scripts": {
    "setup:electron": "node node_modules/electron/install.js",
    "start": "electron .",
    "stage": "node stage.cjs",
    "test": "node --test tests/*.test.cjs",
    "dist": "npm run stage && electron-builder --win nsis --x64 --publish never",
    "release": "npm run stage && electron-builder --win nsis --x64 --publish always"
  },
  "dependencies": { "electron-updater": "6.8.11" },
  "devDependencies": { "electron": "45.1.0", "electron-builder": "26.18.0" },
  "build": {
    "appId": "com.orest3781.studioai",
    "asar": true,
    "files": ["main.cjs", "backend.cjs", "updates.cjs", "package.json"],
    "extraResources": [{"from": "stage/studio", "to": "studio"}],
    "directories": {"output": "dist"},
    "win": {"target": "nsis", "artifactName": "StudioAI-${version}-Windows-${arch}.${ext}"},
    "nsis": {"oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "deleteAppDataOnUninstall": false},
    "publish": [{"provider": "github", "owner": "orest3781", "repo": "studioAI", "releaseType": "draft"}]
  }
}
